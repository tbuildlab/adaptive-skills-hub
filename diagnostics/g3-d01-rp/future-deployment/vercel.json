{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "public",
  "functions": { "api/diagnostic.js": { "maxDuration": 30 } },
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" }
  ] }]
}
