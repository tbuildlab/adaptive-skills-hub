{
  "schema_version": "nexus.ecosystem-source-policy.v1",
  "policy_id": "nexus.ecosystem-source-policy.default",
  "policy_version": "1",
  "mode": "quarantine_only",
  "provider_policy": {
    "allowed_providers": [
      "github"
    ],
    "network_acquisition": "disabled",
    "accepted_intake_kinds": [
      "pre_supplied_zip"
    ],
    "archive_formats": [
      "zip"
    ]
  },
  "resource_limits": {
    "max_policy_bytes": 65536,
    "max_sources": 32,
    "max_input_bytes": 134217728,
    "max_expanded_bytes": 536870912,
    "max_entries": 20000,
    "max_directories": 5000,
    "max_file_bytes": 33554432,
    "max_path_utf8_bytes": 512,
    "max_path_segment_utf8_bytes": 128,
    "max_path_depth": 32,
    "max_components": 128,
    "max_component_entries": 10000,
    "max_component_bytes": 268435456,
    "max_archive_nesting": 1,
    "max_entry_compression_ratio": 100,
    "max_aggregate_compression_ratio": 20,
    "max_findings_per_subject": 1024,
    "max_license_files": 32,
    "max_dependency_manifests": 64,
    "max_instruction_file_bytes": 262144,
    "max_license_or_dependency_file_bytes": 1048576,
    "max_record_bytes": 2097152,
    "max_text_evidence_bytes": 65536,
    "max_ingest_seconds": 60,
    "max_cas_bytes": 2147483648,
    "max_quarantined_revisions_per_source": 8
  },
  "analysis_profiles": {
    "static_analyzer_profile": {
      "schema_version": "nexus.ecosystem-static-analyzer-profile.v1",
      "analyzer_id": "nexus.ecosystem-static",
      "analyzer_version": "1",
      "rules": [
        {
          "rule_id": "archive.nested",
          "rule_version": "1",
          "predicate_id": "magic-prefix-set",
          "parameters": {
            "magic_hex": [
              "1f8b",
              "377abcaf271c",
              "504b0304",
              "526172211a07",
              "7573746172"
            ]
          },
          "category": "ARCHIVE_SAFETY",
          "severity": "MEDIUM",
          "disposition": "REQUIRES_REVIEW"
        },
        {
          "rule_id": "automation.workflow",
          "rule_version": "1",
          "predicate_id": "path-set-or-prefix",
          "parameters": {
            "exact_paths": [
              ".circleci/config.yml",
              ".gitlab-ci.yml",
              "Jenkinsfile"
            ],
            "prefixes": [
              ".github/workflows/"
            ]
          },
          "category": "HOOK_OR_AUTOMATION",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "binary.executable-magic",
          "rule_version": "1",
          "predicate_id": "executable-magic-prefix",
          "parameters": {
            "magic_hex": [
              "0061736d",
              "4d5a",
              "7f454c46",
              "cafebabe",
              "cefaedfe",
              "cffaedfe",
              "feedface",
              "feedfacf"
            ]
          },
          "category": "EXECUTABLE_OR_BINARY",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "content.bidi-control",
          "rule_version": "1",
          "predicate_id": "unicode-codepoint-set",
          "parameters": {
            "codepoints": [
              "061c",
              "200e",
              "200f",
              "202a",
              "202b",
              "202c",
              "202d",
              "202e",
              "2066",
              "2067",
              "2068",
              "2069"
            ]
          },
          "category": "OBFUSCATION",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "content.invalid-role-text",
          "rule_version": "1",
          "predicate_id": "role-text-valid",
          "parameters": {
            "encoding": "utf-8-strict",
            "forbid_nul": true
          },
          "category": "UNSUPPORTED_CONTENT",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "credential.content",
          "rule_version": "1",
          "predicate_id": "slice3b-secret-detector",
          "parameters": {
            "detector_version": "slice3b.v1",
            "maximum_match_bytes": 4096,
            "stream_overlap_bytes": 4095
          },
          "category": "NETWORK_OR_CREDENTIAL",
          "severity": "CRITICAL",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "credential.filename",
          "rule_version": "1",
          "predicate_id": "filename-secret-shape",
          "parameters": {
            "basenames": [
              ".env",
              ".npmrc",
              ".pypirc",
              "credentials",
              "credentials.json",
              "id_ed25519",
              "id_rsa"
            ],
            "suffixes": [
              ".key",
              ".p12",
              ".pem",
              ".pfx"
            ]
          },
          "category": "NETWORK_OR_CREDENTIAL",
          "severity": "CRITICAL",
          "disposition": "REJECTS_CANDIDATE"
        },
        {
          "rule_id": "dependency.manifest",
          "rule_version": "1",
          "predicate_id": "exact-basename-set",
          "parameters": {
            "basenames": [
              "Cargo.lock",
              "Cargo.toml",
              "Gemfile",
              "Gemfile.lock",
              "go.mod",
              "go.sum",
              "package-lock.json",
              "package.json",
              "pnpm-lock.yaml",
              "poetry.lock",
              "pyproject.toml",
              "requirements.txt",
              "setup.cfg",
              "setup.py",
              "uv.lock",
              "yarn.lock"
            ]
          },
          "category": "DEPENDENCY_OR_INSTALL",
          "severity": "MEDIUM",
          "disposition": "REQUIRES_REVIEW"
        },
        {
          "rule_id": "evidence.license-incomplete",
          "rule_version": "1",
          "predicate_id": "license-result-not-equal",
          "parameters": {
            "complete_result": "MATCHES_POLICY_DECLARATION"
          },
          "category": "LICENSE_CHANGE",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "evidence.provenance-inexact",
          "rule_version": "1",
          "predicate_id": "provenance-result-not-equal",
          "parameters": {
            "complete_result": "EXACT_SUBJECT_BOUND"
          },
          "category": "PROVENANCE_MISMATCH",
          "severity": "CRITICAL",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "hook.git-control",
          "rule_version": "1",
          "predicate_id": "path-set-or-prefix",
          "parameters": {
            "exact_paths": [
              ".gitattributes",
              ".gitmodules"
            ],
            "prefixes": [
              ".git/hooks/"
            ]
          },
          "category": "HOOK_OR_AUTOMATION",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "install.declaration",
          "rule_version": "1",
          "predicate_id": "installer-declaration",
          "parameters": {
            "filenames": [
              "bootstrap.py",
              "install.py"
            ],
            "package_scripts": [
              "install",
              "postinstall",
              "preinstall",
              "prepare"
            ],
            "pyproject_section": "build-system"
          },
          "category": "DEPENDENCY_OR_INSTALL",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "instruction.control-claim",
          "rule_version": "1",
          "predicate_id": "collapsed-casefolded-phrase-set",
          "parameters": {
            "phrases": [
              "execute without approval",
              "grant agent authority",
              "grant host authority",
              "grant mcp authority",
              "ignore previous instructions",
              "ignore system instructions",
              "install automatically"
            ]
          },
          "category": "INSTRUCTION_INJECTION",
          "severity": "HIGH",
          "disposition": "REQUIRES_REVIEW"
        },
        {
          "rule_id": "mode.executable",
          "rule_version": "1",
          "predicate_id": "mode-equals",
          "parameters": {
            "mode": "regular_executable"
          },
          "category": "EXECUTABLE_OR_BINARY",
          "severity": "HIGH",
          "disposition": "BLOCKS_REVIEW_COMPLETION"
        },
        {
          "rule_id": "network.declaration",
          "rule_version": "1",
          "predicate_id": "uri-or-token-set",
          "parameters": {
            "schemes": [
              "http://",
              "https://",
              "ws://",
              "wss://"
            ],
            "tokens": [
              "fetch",
              "requests",
              "socket",
              "urllib",
              "webhook"
            ]
          },
          "category": "NETWORK_OR_CREDENTIAL",
          "severity": "MEDIUM",
          "disposition": "REQUIRES_REVIEW"
        },
        {
          "rule_id": "permission.declaration",
          "rule_version": "1",
          "predicate_id": "whole-token-set",
          "parameters": {
            "tokens": [
              "allowed-tools",
              "delegate",
              "mcp",
              "permissions",
              "shell",
              "spawn-agent",
              "subprocess",
              "sudo"
            ]
          },
          "category": "PERMISSION_DECLARATION",
          "severity": "HIGH",
          "disposition": "REQUIRES_REVIEW"
        }
      ]
    },
    "component_classifier_profile": {
      "schema_version": "nexus.ecosystem-component-classifier-profile.v1",
      "classifier_id": "nexus.ecosystem-component-classifier",
      "classifier_version": "1",
      "rules": [
        {
          "rule_id": "component.skill-directory",
          "rule_version": "1",
          "predicate_id": "nonroot-directory-exact-file",
          "parameters": {
            "filename": "SKILL.md",
            "exclude_nested_roots": true
          },
          "component_kind": "GRANULAR_SKILL"
        },
        {
          "rule_id": "component.advisory-agent",
          "rule_version": "1",
          "predicate_id": "first-segment-extension",
          "parameters": {
            "extensions": [
              ".md"
            ],
            "first_segments": [
              ".agents",
              "agents"
            ]
          },
          "component_kind": "ADVISORY_AGENT"
        },
        {
          "rule_id": "component.memory-pattern",
          "rule_version": "1",
          "predicate_id": "segment-extension-set",
          "parameters": {
            "extensions": [
              ".json",
              ".md",
              ".py",
              ".txt",
              ".yaml",
              ".yml"
            ],
            "segments": [
              "code-graph",
              "codegraph",
              "memories",
              "memory",
              "wiki"
            ]
          },
          "component_kind": "MEMORY_PATTERN"
        },
        {
          "rule_id": "component.workflow-pattern",
          "rule_version": "1",
          "predicate_id": "segment-extension-set",
          "parameters": {
            "excluded_prefixes": [
              ".github/workflows/"
            ],
            "extensions": [
              ".json",
              ".md",
              ".py",
              ".rst",
              ".ts",
              ".tsx",
              ".txt",
              ".yaml",
              ".yml"
            ],
            "segments": [
              "example",
              "examples",
              "pattern",
              "patterns",
              "workflow",
              "workflows"
            ]
          },
          "component_kind": "WORKFLOW_PATTERN"
        },
        {
          "rule_id": "component.dependency-reference",
          "rule_version": "1",
          "predicate_id": "static-rule-basename-set",
          "parameters": {
            "static_rule_id": "dependency.manifest"
          },
          "component_kind": "LIBRARY_DEPENDENCY_REFERENCE"
        },
        {
          "rule_id": "component.reference-architecture",
          "rule_version": "1",
          "predicate_id": "readme-or-docs-text",
          "parameters": {
            "extensions": [
              ".md",
              ".rst",
              ".txt"
            ],
            "readme": "README.md",
            "first_segment": "docs"
          },
          "component_kind": "REFERENCE_ARCHITECTURE"
        }
      ]
    }
